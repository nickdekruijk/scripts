#!/usr/bin/env bash
#
# photoscan - scan meerdere foto's in een keer en snijd ze los op
#
# Legt de foto's in een raster op de glasplaat, scant de hele plaat een
# keer, detecteert de losse foto's en schrijft ze als aparte bestanden weg.
#
# Vereist: sane-backends, imagemagick  (brew install sane-backends imagemagick)

set -euo pipefail

# Forceer C-locale: in o.a. nl_NL levert awk's printf komma's als
# decimaalteken op, en die belanden dan in geometrie-argumenten voor
# ImageMagick, dat '12,5000%' leest als breedte 12% x hoogte 5000%.
export LC_ALL=C

# ---------------------------------------------------------------- instellingen
DPI=600                 # scanresolutie
MODE=Color              # Color of Gray
DEPTH=8                 # 8 of 16 bits per kanaal
FORMAT=jpg              # png, tif of jpg
OUTDIR="."
PREFIX="foto"
THRESHOLD=auto          # % helderheid waarboven iets achtergrond is, of "auto"
MINSIZE=25              # kleinste zijde in mm die nog als foto telt
PADDING=0               # mm extra rand rond elke uitsnede (0 = strak)
EDGEMM=1                # mm scannerrand die genegeerd wordt
DESKEW=1                # scheve foto's rechttrekken
ROTATE=0                # vaste kwartslag achteraf: 0, 90, 180 of 270
CONTRAST=0              # zwart- en witpunt oprekken
REFINE=1                # bbox per foto strak natrekken
KEEPFULL=0              # ook de volledige plaatscan bewaren
DEVICE=""
DRYRUN=0
VERBOSE=0
INPUT=""                # bestaande scan hergebruiken i.p.v. opnieuw scannen

MASKDPI=150             # resolutie waarop gedetecteerd wordt
DESKEWMIN=0.05          # graden: daaronder niet roteren, scheelt resamplen
DESKEWMAX=5             # graden: daarboven is de meting niet te vertrouwen
DESKEWPAD=3             # px die na het rechttrekken van elke zijde af gaan
CLIP=0.3                # % pixels dat bij -c naar zwart resp. wit mag

usage() {
    cat <<'EOF'
photoscan - scan meerdere foto's tegelijk en snijd ze los op

Gebruik: photoscan [opties]

  -o DIR        uitvoermap (standaard: huidige map)
  -p PREFIX     bestandsnaam-prefix (standaard: foto)
  -r DPI        resolutie: 300, 600, 1200 (standaard: 600)
  -m MODE       Color of Gray (standaard: Color)
  -f FORMAT     png, tif of jpg (standaard: jpg)
  -b DEPTH      8 of 16 bits (standaard: 8)
  -t PCT        achtergronddrempel in %, of "auto" (standaard: auto)
  -s MM         kleinste zijde die als foto telt (standaard: 25)
  -a MM         extra rand rond elke uitsnede (standaard: 0)
  -e MM         breedte van de te negeren scannerrand (standaard: 1)
  -d DEVICE     scanner-device (standaard: automatisch)
  -i BESTAND    bestaande plaatscan gebruiken i.p.v. opnieuw scannen
  -R GRADEN     alle foto's een kwartslag draaien: 90, 180 of 270
  -c            contrast oprekken (verschoten foto's opfrissen)
  -k            de volledige plaatscan ook bewaren
  -n            alleen detecteren en tonen, niets wegschrijven
  -D            niet rechttrekken (laat de scheefstand staan)
  -N            bbox niet natrekken (laat de marge staan)
  -v            toon timing per stap
  -h            deze hulp

Voorbeelden:
  photoscan -o ~/Scans -p vakantie
  photoscan -r 1200 -b 16 -f tif        # archiefkwaliteit
  photoscan -k -n                       # plaatscan bewaren om af te stellen
  photoscan -i plaat.tif -n -t 80       # drempel handmatig afstellen
  photoscan -R 90                       # foto's lagen op hun kant
  photoscan -c                          # doffe afdrukken opfrissen

Tips:
  Leg de foto's met minstens 1 cm ruimte ertussen. Klep dicht.
  Ze hoeven niet kaarsrecht te liggen: een graad of wat wordt automatisch
  rechtgetrokken. Een kwartslag niet - die kan het script niet raden, dus
  leg de foto's dezelfde kant op en gebruik -R.
EOF
}

while getopts "o:p:r:m:f:b:t:s:a:e:d:i:R:cknvDNh" opt; do
    case $opt in
        o) OUTDIR=$OPTARG ;;
        p) PREFIX=$OPTARG ;;
        r) DPI=$OPTARG ;;
        m) MODE=$OPTARG ;;
        f) FORMAT=$OPTARG ;;
        b) DEPTH=$OPTARG ;;
        t) THRESHOLD=$OPTARG ;;
        s) MINSIZE=$OPTARG ;;
        a) PADDING=$OPTARG ;;
        e) EDGEMM=$OPTARG ;;
        d) DEVICE=$OPTARG ;;
        i) INPUT=$OPTARG ;;
        R) ROTATE=$OPTARG ;;
        c) CONTRAST=1 ;;
        k) KEEPFULL=1 ;;
        n) DRYRUN=1 ;;
        v) VERBOSE=1 ;;
        D) DESKEW=0 ;;
        N) REFINE=0 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done

case "$ROTATE" in
    0|90|180|270) ;;
    *) echo "photoscan: -R moet 90, 180 of 270 zijn (was: $ROTATE)" >&2; exit 1 ;;
esac

# ImageMagick 7 heet 'magick', 6 heet 'convert'
if command -v magick >/dev/null 2>&1; then
    IM="magick"; IDENT="magick identify"
elif command -v convert >/dev/null 2>&1; then
    IM="convert"; IDENT="identify"
else
    echo "photoscan: imagemagick niet gevonden (brew install imagemagick)" >&2
    exit 1
fi

timer() {
    [[ "$VERBOSE" -eq 1 ]] || return 0
    printf '    [%s: %.1fs]\n' "$1" \
        "$(awk -v a="$(date +%s.%N)" -v b="$2" 'BEGIN{print a-b}')" >&2
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/photoscan.XXXXXX")
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

# ------------------------------------------------------------------- scannen
if [[ -n "$INPUT" ]]; then
    [[ -f "$INPUT" ]] || { echo "photoscan: $INPUT bestaat niet" >&2; exit 1; }
    FULL="$INPUT"
    echo "Bestaande scan gebruiken: $INPUT"
else
    command -v scanimage >/dev/null 2>&1 || {
        echo "photoscan: scanimage niet gevonden (brew install sane-backends)" >&2
        exit 1
    }

    if [[ -z "$DEVICE" ]]; then
        DEVICE=$(scanimage -L 2>/dev/null \
                 | sed -n "s/^device \`\([^']*\)'.*/\1/p" | head -1)
        [[ -z "$DEVICE" ]] && { echo "photoscan: geen scanner gevonden" >&2; exit 1; }
    fi

    FULL="$TMP/plaat.tif"
    echo "Scannen op ${DPI} dpi (${MODE}, ${DEPTH}-bit) via ${DEVICE}..."
    TSCAN=$(date +%s.%N)
    scanimage -d "$DEVICE" --format=tiff --mode "$MODE" --depth "$DEPTH" \
              --resolution "$DPI" --expiration-time -1 --progress -o "$FULL"
    printf '  scan gereed in %.0f sec\n' \
        "$(awk -v a="$(date +%s.%N)" -v b="$TSCAN" 'BEGIN{print a-b}')"
fi

# -------------------------------------------------------- foto's detecteren
# Afmetingen als hele pixels: een percentage met decimaalteken is
# locale-gevoelig, een integer nooit.
read -r FW FH <<< "$($IDENT -format '%w %h' "$FULL")"
MASKW=$(awk -v v="$FW" -v m="$MASKDPI" -v d="$DPI" 'BEGIN{printf "%d", v*m/d}')
MASKH=$(awk -v v="$FH" -v m="$MASKDPI" -v d="$DPI" 'BEGIN{printf "%d", v*m/d}')
MINPX=$(awk -v mm="$MINSIZE" -v dpi="$MASKDPI" 'BEGIN{p=mm/25.4*dpi; printf "%d", p*p}')
EDGE=$(awk -v mm="$EDGEMM" -v dpi="$MASKDPI" 'BEGIN{printf "%d", mm/25.4*dpi+1}')
EDGEPX=$(awk -v mm="$EDGEMM" -v dpi="$DPI" 'BEGIN{printf "%d", mm/25.4*dpi}')

if [[ "$MASKW" -lt 50 || "$MASKH" -lt 50 ]]; then
    echo "photoscan: scan lijkt te klein (${FW}x${FH})" >&2
    exit 1
fi

echo "Foto's zoeken (minimaal ${MINSIZE} mm)..."
T0=$(date +%s.%N)

# Stap 1: een kleine grijsversie. Dit is de enige stap die de volledige
# scan moet inlezen; alles daarna werkt op dit kleine plaatje.
$IM "$FULL" \
    -scale "${MASKW}x${MASKH}!" \
    -colorspace Gray \
    -depth 8 \
    "$TMP/gray.png"

# Stap 2: achtergrondniveau meten. De klepbekleding van de ene scanner
# scant als 96% wit, die van de andere als 87% - een vaste drempel werkt
# dus niet. De helderste van de vier hoeken is vrijwel zeker lege
# achtergrond, want foto's zijn donkerder dan de klep.
BG=0
for g in NorthWest NorthEast SouthWest SouthEast; do
    v=$($IM "$TMP/gray.png" -gravity "$g" -crop 60x60+0+0 +repage \
        -format '%[fx:mean*100]' info:)
    v=${v%.*}
    [[ "$v" -gt "$BG" ]] && BG=$v
done

if [[ "$THRESHOLD" == "auto" ]]; then
    if [[ "$BG" -lt 30 ]]; then
        echo "photoscan: achtergrond meet ${BG}% - scan lijkt donker." >&2
        echo "photoscan: lag de klep dicht? Geef anders zelf -t op." >&2
        exit 1
    fi
    THRESHOLD=$((BG - 6))
    [[ "$THRESHOLD" -gt 97 ]] && THRESHOLD=97
    echo "  achtergrond ~${BG}%, drempel ${THRESHOLD}%"
fi

# Stap 3a: scherp masker, zonder blur. De blur hieronder groepeert
# losse stukken tot een foto, maar rekt de rand ook 1-2 pixels op. Voor
# het exact bepalen van de fotorand is dit scherpe masker nodig.
$IM "$TMP/gray.png" \
    -threshold "${THRESHOLD}%" \
    -negate \
    -morphology Open Disk:2 \
    -shave "${EDGE}x${EDGE}" \
    -bordercolor black -border "${EDGE}x${EDGE}" \
    -depth 8 \
    "$TMP/sharp.png"

# Stap 3b: gegroepeerd masker voor het vinden van de foto's
$IM "$TMP/gray.png" \
    -threshold "${THRESHOLD}%" \
    -negate \
    -blur 0x2 -threshold 30% \
    -shave "${EDGE}x${EDGE}" \
    -bordercolor black -border "${EDGE}x${EDGE}" \
    -depth 8 \
    "$TMP/mask.png"
timer "masker" "$T0"

read -r MW MH <<< "$($IDENT -format '%w %h' "$TMP/mask.png")"

if [[ "$MW" -gt $((MASKW + 20)) || "$MH" -gt $((MASKH + 20)) ]]; then
    echo "photoscan: masker is ${MW}x${MH}, verwacht ${MASKW}x${MASKH}" >&2
    echo "photoscan: geometrie verkeerd geinterpreteerd - meld dit" >&2
    exit 1
fi

T0=$(date +%s.%N)
$IM "$TMP/mask.png" \
    -define connected-components:verbose=true \
    -define connected-components:area-threshold="$MINPX" \
    -connected-components 8 \
    null: > "$TMP/blobs.txt" 2>&1 || true
timer "detectie" "$T0"

# regels: "  1: 240x180+60+80 179.5,169.5 43200 gray(255)"
# na -negate is de achtergrond gray(0); alleen witte blobs zijn foto's
awk -v minpx="$MINPX" -v mw="$MW" -v mh="$MH" '
    /^[[:space:]]*[0-9]+:/ {
        bbox = $2; area = $4; color = $5
        # wit is gray(255), gray(65535), gray(100%) of srgb(255,255,255)
        # afhankelijk van de build - dus: elk getal > 0
        n = color; gsub(/[^0-9]/, "", n)
        if (n + 0 == 0) next
        if (area + 0 < minpx) next
        split(bbox, a, /[x+]/)
        w = a[1]; h = a[2]; x = a[3]; y = a[4]
        if (w > mw * 0.97 && h > mh * 0.97) next
        print w, h, x, y
    }
' "$TMP/blobs.txt" | sort -k4 -n -k3 -n > "$TMP/regions.txt"

COUNT=$(wc -l < "$TMP/regions.txt" | tr -d ' ')

if [[ "$COUNT" -eq 0 ]]; then
    mkdir -p "$OUTDIR"
    cp "$TMP/mask.png" "$OUTDIR/${PREFIX}-masker.png"
    echo
    echo "Geen foto's gevonden (drempel ${THRESHOLD}%)."
    echo
    echo "Bekijk ${PREFIX}-masker.png: je foto's horen daarin wit te zijn"
    echo "op een zwarte achtergrond. Loopt er een witte band langs de rand,"
    echo "verhoog dan -e."
    if [[ -z "$INPUT" ]]; then
        cp "$FULL" "$OUTDIR/${PREFIX}-plaat.tif"
        echo
        echo "De scan is bewaard als ${PREFIX}-plaat.tif - opnieuw scannen"
        echo "hoeft niet. Stel af met:"
        echo "  photoscan -i ${PREFIX}-plaat.tif -r $DPI -n -t $((THRESHOLD - 5))"
    fi
    exit 1
fi

echo "$COUNT foto('s) gevonden."
echo

# ------------------------------------------------------------- uitsnijden
mkdir -p "$OUTDIR"
PADPX=$(awk -v mm="$PADDING" -v dpi="$DPI" 'BEGIN{printf "%d", mm/25.4*dpi}')

# Alle uitsnedes in EEN aanroep, zodat de scan een keer wordt gedecodeerd
# in plaats van een keer per foto.
CMD=("$IM" "$FULL")
N=0
while read -r w h x y; do
    N=$((N + 1))

    # De blur in het groepeermasker rekt de rand op, en losse stofjes op
    # het glas blokkeren -trim volledig. Daarom de rand hier opnieuw
    # bepalen op het scherpe masker, binnen het gevonden gebied.
    if [[ "$REFINE" -eq 1 ]]; then
        rb=$($IM "$TMP/sharp.png" -crop "${w}x${h}+${x}+${y}" +repage \
             -format '%@' info: 2>/dev/null || true)
        if [[ "$rb" =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
            rw=${BASH_REMATCH[1]}; rh=${BASH_REMATCH[2]}
            rx=${BASH_REMATCH[3]}; ry=${BASH_REMATCH[4]}
            if [[ "$rw" -gt 10 && "$rh" -gt 10 ]]; then
                x=$((x + rx)); y=$((y + ry)); w=$rw; h=$rh
            fi
        fi
    fi

    read -r cx cy cw ch <<< "$(awk -v w="$w" -v h="$h" -v x="$x" -v y="$y" \
        -v mw="$MW" -v pad="$PADPX" -v fw="$FW" -v fh="$FH" -v e="$EDGEPX" 'BEGIN{
            f = fw / mw
            cx = int(x*f) - pad; cy = int(y*f) - pad
            cw = int(w*f) + 2*pad; ch = int(h*f) + 2*pad
            # nooit tot in de scannerrand snijden: die scant donkerder dan
            # de klep en levert anders een grijze band aan die zijde
            if (cx < e) { cw -= (e - cx); cx = e }
            if (cy < e) { ch -= (e - cy); cy = e }
            if (cx + cw > fw - e) cw = fw - e - cx
            if (cy + ch > fh - e) ch = fh - e - cy
            print cx, cy, cw, ch
        }')"

    # Scheefstand meten op het scherpe masker, niet op de foto zelf.
    # -deskew doet een Radon-transform op zwart/wit; op een binair masker
    # is dat betrouwbaar, op fotobeeld vindt het willekeurige hoeken. Dat
    # het masker op MASKDPI staat kost nauwelijks precisie: gemeten
    # verschil met volle resolutie is 0,03 graden, ~2 px over een hele
    # fotohoogte, en dat valt binnen DESKEWPAD.
    ANGLE=0
    if [[ "$DESKEW" -eq 1 ]]; then
        a=$($IM "$TMP/sharp.png" -crop "${w}x${h}+${x}+${y}" +repage \
            -deskew 40% -format '%[deskew:angle]' info: 2>/dev/null || true)
        [[ "$a" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || a=0
        ANGLE=$(awk -v a="$a" -v lo="$DESKEWMIN" -v hi="$DESKEWMAX" 'BEGIN{
            b = (a < 0) ? -a : a
            printf "%.4f", (b < lo || b > hi) ? 0 : a
        }')
    fi
    SKEWED=$(awk -v a="$ANGLE" 'BEGIN{print (a > 0 || a < 0) ? 1 : 0}')

    # Na het draaien past er een kleinere rechthoek binnen het beeld. Voor
    # een foto w x h onder hoek t geldt W = w cos t + h sin t en
    # H = w sin t + h cos t; dat stelsel omgekeerd levert de strakke maat.
    # Uitrekenen dus, want -trim loopt hier weer op stofjes stuk.
    DW=$cw; DH=$ch; OX=0; OY=0
    if [[ "$SKEWED" -eq 1 ]]; then
        read -r DW DH OX OY <<< "$(awk -v W="$cw" -v H="$ch" -v a="$ANGLE" \
            -v m="$DESKEWPAD" 'BEGIN{
                r = a * 3.14159265358979 / 180
                s = sin(r); if (s < 0) s = -s
                c = cos(r); c2 = c*c - s*s
                w = (W*c - H*s)/c2 - 2*m
                h = (H*c - W*s)/c2 - 2*m
                printf "%d %d %d %d", w, h, (W*c + H*s - w)/2, (W*s + H*c - h)/2
            }')"
    fi

    # bij een kwartslag wisselen breedte en hoogte in de rapportage om
    if [[ "$ROTATE" -eq 90 || "$ROTATE" -eq 270 ]]; then
        RW=$DH; RH=$DW
    else
        RW=$DW; RH=$DH
    fi
    MMW=$(awk -v p="$RW" -v d="$DPI" 'BEGIN{printf "%.0f", p*25.4/d}')
    MMH=$(awk -v p="$RH" -v d="$DPI" 'BEGIN{printf "%.0f", p*25.4/d}')

    OUTFILE="$OUTDIR/${PREFIX}-$(printf '%02d' "$N").${FORMAT}"
    printf '  %2d. %4d x %4d mm  ->  %s\n' "$N" "$MMW" "$MMH" "$(basename "$OUTFILE")"
    [[ "$VERBOSE" -eq 1 && "$SKEWED" -eq 1 ]] && \
        printf '      rechtgetrokken over %s graden\n' "$ANGLE" >&2

    [[ "$DRYRUN" -eq 1 ]] && continue

    CMD+=( "(" +clone -crop "${cw}x${ch}+${cx}+${cy}" +repage )
    if [[ "$SKEWED" -eq 1 ]]; then
        CMD+=( -background white
               -rotate "$(awk -v a="$ANGLE" 'BEGIN{printf "%.4f", -a}')" +repage
               -crop "${DW}x${DH}+${OX}+${OY}" +repage )
    fi
    [[ "$ROTATE" -ne 0 ]] && CMD+=( -rotate "$ROTATE" )
    # Contrast pas hier, na het strak snijden: de vulling die -rotate
    # bijzet is 100% wit en zou anders het witpunt bepalen. Rekken gebeurt
    # op de L van Lab, niet op R, G en B apart - per kanaal verschuift de
    # kleurbalans, en gevraagd is contrast, geen kleurcorrectie.
    [[ "$CONTRAST" -eq 1 ]] && CMD+=(
        -colorspace Lab -channel R -contrast-stretch "${CLIP}%x${CLIP}%"
        +channel -colorspace sRGB )
    CMD+=( -quality 95 -write "$OUTFILE" +delete ")" )
done < "$TMP/regions.txt"

if [[ "$DRYRUN" -eq 0 ]]; then
    T0=$(date +%s.%N)
    CMD+=( null: )
    "${CMD[@]}"
    timer "uitsnijden" "$T0"
fi

if [[ "$KEEPFULL" -eq 1 && -z "$INPUT" && "$DRYRUN" -eq 0 ]]; then
    cp "$FULL" "$OUTDIR/${PREFIX}-plaat.tif"
    echo
    echo "Volledige plaatscan: ${PREFIX}-plaat.tif"
fi

echo
if [[ "$DRYRUN" -eq 1 ]]; then
    echo "Testmodus - niets weggeschreven."
else
    echo "Klaar: $COUNT bestand(en) in $OUTDIR"
fi