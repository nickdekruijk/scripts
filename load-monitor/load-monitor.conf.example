# /etc/load-monitor.conf - settings for load-monitor. Mode 600, root only:
# it holds the password for Apache's /server-status page.
#
# Every line is plain shell; the script sources this file. Anything you leave
# out keeps the default from the script.

# Load1 at or above this value triggers a snapshot.
THRESHOLD=6

# One line per minute: epoch, load1, load5, load15, tab separated.
LOG=/var/log/load.log

# Snapshots go here as YYYY-MM-DD_HHMMSS.txt and are removed after this many days.
SNAPSHOT_DIR=/var/log/load-snapshots
RETENTION_DAYS=90

# IPs to leave out of the per-IP counts. Behind nginx_apache the server's own
# IP shows up as the busiest "client", because nginx proxies to Apache over it.
# 203.0.113.10 below is a documentation address (RFC 5737, TEST-NET-3), not a
# real one; put your server's public IP here.
SELF_IPS="203.0.113.10 127.0.0.1"

# Apache's status page, read straight from Apache on its TLS port, not through
# nginx. The Location is global, so any healthy vhost serves it; the first host
# in STATUS_HOSTS that returns the real page wins. On DirectAdmin the default
# vhost gives a silent 500 and non-www names a 301, so list www hostnames, and
# prefer ones you control over customer domains.
STATUS_URL="https://127.0.0.1:8081/server-status"
STATUS_HOSTS="www.example.com www.example.org"
STATUS_USER=info
# CustomBuild protects /server-status with basic auth, generates the password,
# and writes it in plain text to the file below ("# Username:" / "# Password:").
# Both are regenerated on every ./build rewrite_confs, so the script reads the
# file at runtime. Leave STATUS_PW empty unless you manage the password yourself
# (htpasswd -b /var/www/passwd-server-status info ...); a set STATUS_PW wins.
STATUS_PW_FILE=/etc/httpd/conf/extra/httpd-info.conf.secret
STATUS_PW=""

# DirectAdmin's MySQL credentials file (user=..., passwd=...). Leave empty on a
# box where root reaches MySQL over socket auth (a plain "mysql" as root works);
# the script falls back to that by itself.
MYSQL_CONF=/usr/local/directadmin/conf/mysql.conf

# Per-domain nginx access logs, used for the "last 2 minutes" traffic block.
DOMAIN_LOGS=/var/log/nginx/domains

# ---------------------------------------------------------------------------
# nginx-only boxes (Laravel Forge and the like)
#
# No Apache, no per-domain logs, no DirectAdmin. Set it up like this instead:
#
#   STATUS_URL=""                            # skips the server-status block
#   STATUS_HOSTS=""
#   MYSQL_CONF=""                            # root over socket auth
#   DOMAIN_LOGS=""                           # no per-domain logs
#   ACCESS_LOGS="/var/log/nginx/access.log"
#   FPM_LOGS="/var/log/php*-fpm.log"
#
# Block 5 then reads the combined log and reports client IPs, status codes and
# user agents, but not domains: the default log_format has no $host, and adding
# one means editing the web server config. List more than one file in
# ACCESS_LOGS and block 5 counts per log file instead, which on a Forge box is
# usually per site: one vhost with its own access_log, the rest inheriting the
# global one or logging nothing at all.
# Block 6 is skipped and block 7 takes over: the requests in flight, counted per
# pool from the php-fpm unix sockets.
# ---------------------------------------------------------------------------

# Combined access log(s), space separated, globs allowed. Only read when
# DOMAIN_LOGS is empty or missing. With two or more files, block 5 also breaks
# the requests down per log file, labelled with its basename.
ACCESS_LOGS=""
# How many lines to look back in each. Everything older than two minutes is
# thrown away anyway; this only has to be more than two busy minutes' worth.
ACCESS_LOG_TAIL=20000

# php-fpm master logs, space separated, globs allowed. When set, block 2 shows
# the last few "max_children reached" warnings under the live worker counts.
# DirectAdmin: /usr/local/php*/var/log/php-fpm.log. Forge: /var/log/php*-fpm.log.
FPM_LOGS=""

# Which unix sockets count as php-fpm in block 7. The default matches both
# spellings in use: /run/php/php8.3-fpm-site.sock on Forge and Debian, and
# /usr/local/php81/sockets/site.sock on DirectAdmin, which has no "fpm" in the
# path at all. Check with "ss -xH state established" if a box disagrees.
FPM_SOCKET_RE="fpm|/sockets/"
