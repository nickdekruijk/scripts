#!/bin/bash
#
# load-monitor - logs the load average every minute and, when it is high,
# captures a snapshot of what the server is doing at that moment.
#
# Built to replace a php cron script that mailed a snapshot on high load. The
# mail turned out to be the only record of several incidents, and mail gets
# deleted, so this one also writes the snapshot to disk. It also captures the
# things that had to be reconstructed afterwards from sar and log archives:
# who holds the memory, which php-fpm pool is full, whether the box is
# swapping, and which requests are in flight right now.
#
# Every run:
#   - appends "epoch<TAB>load1<TAB>load5<TAB>load15" to LOG
#
# When load1 >= THRESHOLD, or when called with "debug":
#   - prints a snapshot to stdout (cron mails it) and writes the same text to
#     SNAPSHOT_DIR/YYYY-MM-DD_HHMMSS.txt, kept RETENTION_DAYS days
#   - the snapshot contains: top, connections per IP, D-state processes, the
#     MySQL processlist, memory per account and per process, who sits in swap,
#     php-fpm workers per pool, vmstat (swap in/out), OOM-killer messages, web
#     traffic of the last two minutes, and the requests that are in flight
#     right now
#
# What it deliberately does not do: restart anything. The script it replaced
# restarted nginx and httpd at load >= 6. That cost about a minute of CPU on
# a box with ModSecurity, and because it keyed off the lagging one-minute
# average it regularly fired a second time when the real problem was already
# over. The second peak in those mails was the restart itself.
#
# Configuration lives in CONF (default /etc/load-monitor.conf), see
# load-monitor.conf.example. Everything server specific goes there, so this
# file is the same on every machine. It runs on two kinds of box:
#
#   DirectAdmin + nginx_apache   per-domain access logs (DOMAIN_LOGS), a MySQL
#                                password file (MYSQL_CONF), and Apache's
#                                scoreboard for requests in flight (STATUS_URL)
#   Laravel Forge, nginx only    one or more combined access logs (ACCESS_LOGS,
#                                counted per log file when there are several),
#                                MySQL root over socket auth, no Apache. Leave
#                                STATUS_URL empty; requests in flight are then
#                                counted from the php-fpm unix sockets instead
#
# Usage:
#   load-monitor            normal run (this is what cron calls, every minute)
#   load-monitor debug      force a snapshot at any load, useful for testing
#   load-monitor --help
#
# Requires bash, flock, ss, vmstat and top. curl for Apache's server-status,
# mysql for the processlist. Linux only (GNU date, /proc).

set -u
export LC_ALL=C   # never let a locale turn 0.27 into 0,27 in the log
# cron on EL7 runs with PATH=/usr/bin:/bin, and ss lives in /usr/sbin. Without
# this the connections and listening-sockets blocks come out empty under cron
# while working fine from an interactive shell.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

CONF="${LOAD_MONITOR_CONF:-/etc/load-monitor.conf}"

# ---- defaults, overridable in CONF -----------------------------------------
THRESHOLD=6
LOG=/var/log/load.log
SNAPSHOT_DIR=/var/log/load-snapshots
RETENTION_DAYS=90
LOCK=/run/load-monitor.lock
LOCK_COUNT=/run/load-monitor.lockcount
SELF_IPS="127.0.0.1"
STATUS_URL="https://127.0.0.1:8081/server-status"
STATUS_HOSTS=""
STATUS_USER=info
STATUS_PW=""
# CustomBuild writes the generated /server-status credentials here and regenerates
# the file on every ./build rewrite_confs. Read it at runtime so a rewrite cannot
# break the status block. STATUS_PW, if set, overrides it.
STATUS_PW_FILE=/etc/httpd/conf/extra/httpd-info.conf.secret
MYSQL_CONF=/usr/local/directadmin/conf/mysql.conf
DOMAIN_LOGS=/var/log/nginx/domains
# Fallback for boxes without per-domain logs: one or more combined access logs,
# space separated, globs allowed. Only used when DOMAIN_LOGS is empty or gone.
ACCESS_LOGS=""
ACCESS_LOG_TAIL=20000
# php-fpm master logs, space separated, globs allowed. Used to show the last
# "max_children reached" warnings next to the live worker counts.
FPM_LOGS=""
# Which unix sockets count as php-fpm in the requests-in-flight block. Covers both
# spellings seen in the wild: /run/php/php8.3-fpm-site.sock on Debian and Forge,
# /usr/local/php81/sockets/site.sock on DirectAdmin.
FPM_SOCKET_RE="fpm|/sockets/"

case "${1:-}" in
    # print the header comment, however long it is, without tracking line numbers
    -h|--help) awk 'NR>=3 && /^#/ {sub(/^# ?/,""); print; next} NR>=3 {exit}' "$0"; exit 0 ;;
esac
DEBUG=0; [ "${1:-}" = "debug" ] && DEBUG=1

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

# ---- one instance at a time -------------------------------------------------
# A snapshot takes a few seconds; cron fires every minute. If the previous run
# still holds the lock, skip this minute, and only complain when that happens
# twice in a row.
exec 9>"$LOCK"
if ! flock -n 9; then
    n=$(( $(cat "$LOCK_COUNT" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$LOCK_COUNT"
    [ "$n" -ge 2 ] && echo "$(date '+%b %d %H:%M:%S')	$LOCK held for $n consecutive runs"
    exit 0
fi
echo 0 > "$LOCK_COUNT"

# ---- load, straight from the kernel -----------------------------------------
read -r L1 L5 L15 _ < /proc/loadavg
printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$L1" "$L5" "$L15" >> "$LOG"

high=$(awk -v l="$L1" -v t="$THRESHOLD" 'BEGIN{print (l+0 >= t+0) ? 1 : 0}')
[ "$high" = 1 ] || [ "$DEBUG" = 1 ] || exit 0

# ---- snapshot ---------------------------------------------------------------
snapshot() {
    echo "$(date '+%d-%m %H:%M:%S') The server is heavily loaded: $L1, $L5, $L15"
    echo

    echo "TOP 10"; echo "================================"
    top -bn1 2>/dev/null | head -17
    echo

    echo "TOP 10 CONNECTIONS (per IP; own IPs are reverse-proxy traffic)"; echo "================================"
    ss -Htn state established 2>/dev/null | awk '{print $4}' | sed 's/:[0-9]*$//; s/[][]//g; s/^::ffff://' \
        | sort | uniq -c | sort -rn | head -10
    echo

    echo "PROCESSES IN D STATE (waiting on disk)"; echo "================================"
    ps -eo user,pid,stat,pcpu,pmem,comm --no-headers | awk '$3 ~ /^D/' | head -10
    echo "(empty = none)"; echo

    echo "MYSQL PROCESSLIST (non-sleeping)"; echo "================================"
    # Two ways in. DirectAdmin keeps a password file (MYSQL_CONF); its contents go
    # through a temp defaults file so they never appear on a command line. On a
    # Forge box there is no such file, but root reaches MySQL over socket auth, so
    # a bare "mysql" works. Try the file first, then the socket, then give up.
    local cnf="" mysql_ok=0
    if command -v mysql >/dev/null 2>&1; then
        if [ -r "$MYSQL_CONF" ]; then
            cnf=$(mktemp) && chmod 600 "$cnf"
            awk -F= '/^(user|passwd|password)=/{k=$1; sub(/^passwd$/,"password",k); print k"="$2}' "$MYSQL_CONF" \
                | sed '1i [client]' > "$cnf"
            mysql_ok=1
        elif mysql -N -e 'SELECT 1' >/dev/null 2>&1; then
            mysql_ok=1
        fi
    fi
    if [ "$mysql_ok" = 1 ]; then
        local -a my=(mysql)
        [ -n "$cnf" ] && my+=("--defaults-extra-file=$cnf")
        "${my[@]}" -e 'SHOW FULL PROCESSLIST' 2>&1 \
            | awk -F'\t' 'NR==1 || $5 != "Sleep"' | cut -c1-220
        echo "sleeping connections: $("${my[@]}" -N -e 'SHOW PROCESSLIST' 2>/dev/null | awk -F'\t' '$5=="Sleep"' | wc -l)"
    elif ! command -v mysql >/dev/null 2>&1; then
        echo "skipped: no mysql client"
    else
        echo "skipped: $MYSQL_CONF not readable and socket auth refused"
    fi
    [ -n "$cnf" ] && rm -f "$cnf"
    echo

    echo "1. MEMORY PER ACCOUNT (RSS in MB, top 10)"; echo "--------------------------------"
    ps -eo user:20,rss --no-headers | awk '{s[$1]+=$2} END{for(u in s) printf "%7d MB  %s\n", s[u]/1024, u}' | sort -rn | head -10
    echo "   per process name (RSS; shared memory counted once per process, so nginx with ModSecurity looks inflated)"
    ps -eo rss,comm --no-headers | awk '{s[$2]+=$1} END{for(c in s) printf "%7d MB  %s\n", s[c]/1024, c}' | sort -rn | head -8
    echo "   in swap, per process name (a full swapfile with nothing paging in is slow, not an emergency)"
    awk '/^SwapTotal:/{t=$2} /^SwapFree:/{f=$2} END{printf "%7d MB  used of %d MB total\n", (t-f)/1024, t/1024}' /proc/meminfo
    # a process can exit between the glob and the read, hence the discarded errors
    awk '/^Name:/{n=$2} /^VmSwap:/{s[n]+=$2}
         END{for(k in s) if(s[k]>0) printf "%7d MB  %s\n", s[k]/1024, k}' /proc/[0-9]*/status 2>/dev/null \
        | sort -rn | head -5
    echo

    echo "2. PHP-FPM WORKERS PER POOL (top 12)"; echo "--------------------------------"
    # Three things matter and they live in two places: the pool name is only in the
    # process title ("php-fpm: pool mediawise"), while the PHP version is only in
    # comm (php-fpm81, php-fpm8.3). Take both, so one line says which site, which
    # account and which interpreter.
    printf '%s\n' "      n  pool                 account          version"
    ps -eo user:20,comm:16,args --no-headers \
        | awk '$3=="php-fpm:" && $4=="pool" {c[$5"\t"$1"\t"$2]++}
               END{for(k in c){split(k,f,"\t"); printf "%7d  %-20s %-16s %s\n", c[k], f[1], f[2], f[3]}}' \
        | sort -rn | head -12
    ps -eo comm:16,args --no-headers \
        | awk '$2=="php-fpm:" && $3=="master" {gsub(/[()]/,"",$5); printf "%7s  %-20s %-16s %s %s\n", "", "(master)", "", $1, $5}' | sort
    if [ -n "$FPM_LOGS" ]; then
        echo "   last max_children warnings (own timestamps, not necessarily this spike):"
        # shellcheck disable=SC2086
        grep -hs max_children $FPM_LOGS | tail -3 | sed 's/^/      /'
    fi
    echo

    echo "3. VMSTAT (si/so = swap in/out per second, r = run queue, wa = iowait)"; echo "--------------------------------"
    vmstat 1 3 2>/dev/null | tail -4
    echo

    echo "4. OOM KILLER (last 5 messages in dmesg)"; echo "--------------------------------"
    dmesg -T 2>/dev/null | grep -iE "out of memory|oom-killer|killed process" | tail -5
    echo "(empty = none)"; echo

    local m1 m0 tmp n per_domain=0 per_logfile=0 nlogs=0
    m1=$(date +%d/%b/%Y:%H:%M); m0=$(date -d '-1 min' +%d/%b/%Y:%H:%M)
    tmp=$(mktemp)
    if [ -n "$DOMAIN_LOGS" ] && [ -d "$DOMAIN_LOGS" ]; then
        per_domain=1
        echo "5. WEB TRAFFIC, LAST 2 MINUTES (only logs written to in that window)"; echo "--------------------------------"
        find "$DOMAIN_LOGS" -name "*.log" ! -name "*.error.log" -mmin -2 2>/dev/null | head -40 | while read -r f; do
            tail -n 500 "$f" | grep -aF -e "[$m1" -e "[$m0" \
                | awk -v d="$(basename "$f" .log)" -F'"' '{split($1,a," "); print d "\t" a[1] "\t" $3 "\t" $6}'
        done > "$tmp"
    else
        # One combined log per site at best. The vhost is not in the default nginx
        # log_format, so a breakdown per domain within one log is simply not
        # available here; adding $host would mean touching the web server config.
        # ACCESS_LOGS may list several files, and then each line is labelled with
        # the name of the log it came from, which is as close to a per-site split
        # as a Forge box gets without editing nginx.
        echo "5. WEB TRAFFIC, LAST 2 MINUTES (combined access logs, last $ACCESS_LOG_TAIL lines each)"; echo "--------------------------------"
        # shellcheck disable=SC2086
        for f in $ACCESS_LOGS; do
            [ -r "$f" ] || continue
            nlogs=$((nlogs + 1))
            # -a, because access logs are not reliably text: a bot sending a raw
            # binary request puts NUL bytes in the log, and without it grep says
            # "binary file matches" and prints nothing, so the whole block reads
            # as zero requests during exactly the minutes that matter.
            tail -n "$ACCESS_LOG_TAIL" "$f" | grep -aF -e "[$m1" -e "[$m0" \
                | awk -v d="$(basename "$f" .log)" -F'"' '{split($1,a," "); print d "\t" a[1] "\t" $3 "\t" $6}'
        done > "$tmp"
        [ "$nlogs" -gt 1 ] && per_logfile=1
    fi
    n=$(wc -l < "$tmp"); echo "requests: $n"
    if [ "$n" -gt 0 ]; then
        # via ENVIRON, not -v: awk -v processes backslash escapes and warns on \.
        SELF_RE="^($(echo "$SELF_IPS" | sed 's/ /|/g; s/\./\\./g'))$"; export SELF_RE
        if [ "$per_domain" = 1 ]; then
            echo "   domains:";  awk -F'\t' '{c[$1]++} END{for(k in c) printf "%6d  %s\n", c[k], k}' "$tmp" | sort -rn | head -5
        elif [ "$per_logfile" = 1 ]; then
            # not domains: one of these logs can hold several vhosts, and a vhost
            # with access_log off appears in none of them.
            echo "   access logs (combined log_format has no \$host, so this is per log file, not per domain):"
            awk -F'\t' '{c[$1]++} END{for(k in c) printf "%6d  %s\n", c[k], k}' "$tmp" | sort -rn | head -5
        else
            echo "   domains: not logged (combined log_format has no \$host)"
        fi
        echo "   client IPs (own IPs excluded):"; awk -F'\t' '$2 !~ ENVIRON["SELF_RE"] {c[$2]++} END{for(k in c) printf "%6d  %s\n", c[k], k}' "$tmp" | sort -rn | head -5
        echo "   status codes:"; awk -F'\t' '{split($3,s," "); c[s[1]]++} END{for(k in c) printf "%6d  %s\n", c[k], k}' "$tmp" | sort -rn | head -5
        echo "   user agents:";  awk -F'\t' '{c[$4]++} END{for(k in c) printf "%6d  %.90s\n", c[k], k}' "$tmp" | sort -rn | head -3
    fi
    rm -f "$tmp"; echo

    echo "6. APACHE SERVER-STATUS (requests in flight right now)"; echo "--------------------------------"
    # Read straight from Apache, not through the reverse proxy. On DirectAdmin
    # the default vhost answers this path with a silent 500 and non-www names
    # with a 301 to www, so STATUS_HOSTS lists a few healthy www hostnames and
    # the first one that returns the real page wins. <Location /server-status>
    # is global in httpd-info.conf, so any sane vhost serves it.
    local body code host ok=0 pw="$STATUS_PW"
    if [ -n "$STATUS_URL" ] && [ -z "$pw" ] && [ -r "$STATUS_PW_FILE" ]; then
        pw=$(sed -nE 's/^#?[[:space:]]*[Pp]assword:[[:space:]]*([^[:space:]]+).*/\1/p' "$STATUS_PW_FILE" | head -1)
        u=$(sed -nE 's/^#?[[:space:]]*[Uu]sername:[[:space:]]*([^[:space:]]+).*/\1/p' "$STATUS_PW_FILE" | head -1)
        [ -n "$u" ] && STATUS_USER=$u
    fi
    body=$(mktemp)
    if [ -z "$STATUS_URL" ]; then
        echo "   skipped: STATUS_URL empty, no Apache on this box (see block 7 instead)"
    elif [ -z "$pw" ] || [ -z "$STATUS_HOSTS" ]; then
        echo "   skipped: no password (STATUS_PW or readable STATUS_PW_FILE) or no STATUS_HOSTS in $CONF"
    else
        for host in $STATUS_HOSTS; do
            code=$(curl -sk -o "$body" -w '%{http_code}' -m 5 -u "$STATUS_USER:$pw" -H "Host: $host" "$STATUS_URL")
            if [ "$code" = "200" ] && grep -q "Apache Server Status" "$body"; then ok=1; break; fi
            [ "$code" = "401" ] && break
        done
        if [ "$ok" = 1 ]; then
            curl -sk -m 5 -u "$STATUS_USER:$pw" -H "Host: $host" "$STATUS_URL?auto" \
                | awk -F': ' '/^(BusyWorkers|IdleWorkers|ReqPerSec)/ {printf "%s=%s  ", $1, $2} END{print ""}'
            echo "   busy workers (M=W):  sec  client            vhost                          request"
            # scoreboard rows span several source lines: join first, then split on </tr>
            awk '/<table border="0">/{f=1} f' "$body" | tr -d '\n' \
                | sed -e 's#</tr>#\n#g' -e 's#</t[dh]>#\t#g' -e 's#<[^>]*>##g' \
                | awk -F'\t' '$4=="W" && $15 !~ /server-status/ {printf "   %4s  %-17s %-30s %.70s\n", $6, $12, $14, $15}' \
                | sort -rn | head -15
        elif [ "$code" = "401" ]; then
            echo "   server-status returned 401 for user $STATUS_USER: credentials in $STATUS_PW_FILE (or STATUS_PW) no longer match /var/www/passwd-server-status."
        else
            echo "   server-status not reachable via STATUS_HOSTS (last HTTP code ${code:-none})"
        fi
    fi
    rm -f "$body"; echo

    echo "7. PHP-FPM REQUESTS IN FLIGHT (established unix sockets, per pool)"; echo "--------------------------------"
    # Without Apache there is no scoreboard, but every request nginx has handed to
    # php-fpm is an established connection on that pool's socket, so counting them
    # gives the same "how many are running right now, and where" per pool. It does
    # not give the URL; that would need pm.status_path on every pool.
    # Only the local-address column carries the path: the nginx side of the same
    # connection lists it as its peer, so filtering the whole line counts twice.
    local fpm_n
    fpm_n=$(ss -xH state established 2>/dev/null | awk -v re="$FPM_SOCKET_RE" '$4 ~ re' | wc -l)
    echo "   total: $fpm_n"
    ss -xH state established 2>/dev/null | awk -v re="$FPM_SOCKET_RE" '$4 ~ re {print $4}' \
        | sort | uniq -c | sort -rn | head -15 | sed 's/^/   /'
    echo "(empty = no request was being executed at this instant)"; echo

    echo "LISTENING SOCKETS"; echo "================================"
    ss -Hltnp 2>/dev/null | awk '{print $4, $6}' | sed 's/users:(("//; s/",.*//' | sort -u | head -30
}

mkdir -p "$SNAPSHOT_DIR" && chmod 700 "$SNAPSHOT_DIR"
out="$SNAPSHOT_DIR/$(date +%Y-%m-%d_%H%M%S).txt"
# Write the file first and only then echo it, rather than "snapshot | tee $out".
# With tee, anything that stops reading stdout halfway kills tee on the spot and
# leaves a truncated snapshot behind: run it over ssh through "head" once and the
# record on disk ends mid-block. The file is the thing worth protecting here.
umask 077
snapshot > "$out" 2>&1
chmod 600 "$out" 2>/dev/null
cat "$out"
find "$SNAPSHOT_DIR" -maxdepth 1 -name '*.txt' -mtime +"$RETENTION_DAYS" -delete 2>/dev/null
exit 0
