#!/bin/bash
#
# rspamd-anon - maskeert e-mailadressen van eigen domeinen in mail-logs
#
# Gebruik:
#   tail -n1000 /var/log/rspamd/rspamd.log | rspamd-anon
#   rspamd-anon < bericht.eml
#   grep "iets" /var/log/exim/mainlog | rspamd-anon
#   journalctl -u dovecot | rspamd-anon
#
# Adressen op eigen domeinen worden vervangen door een stabiele hash,
# zodat hetzelfde adres herkenbaar blijft als hetzelfde. Externe domeinen
# (spammers, mailinglijsten) blijven onaangetast zodat patronen zichtbaar zijn.
#
# Loginnamen zonder @ (DirectAdmin-gebruikers, of een naam die per ongeluk in
# het veld voor de gebruikersnaam staat) krijgen ook een hash: in Dovecot-logs
# als user=<...>, proxy(...), passwd-file(...) enzovoort, en in Roundcube als
# "login for ...". Zo werkt het ook op een Dovecot-proxy voor DirectAdmin.
#
# IP-adressen van gebruikers worden gemaskeerd waar ze bij een login horen:
# rip= en auth-regels in Dovecot, "from" in Roundcube, en Exim-regels met A= of
# "authenticator failed". De eerste twee blokken blijven leesbaar (provider,
# reeks), de rest wordt een hash: 192.0.x.x-1a2b3c. Afzenders van inkomende mail
# (rspamd ip:, Exim H= zonder login) blijven staan: dat zijn mailservers.
# Nooit gemaskeerd: loopback, privé-reeksen en de IP's in /etc/virtual/proxy_hosts_ip.
#
#   rspamd-anon --keep-ip    IP-adressen niet maskeren

KEEP_IP=0
[ "${1:-}" = "--keep-ip" ] && KEEP_IP=1

SALT_FILE="/etc/rspamd-anon.salt"

# Salt aanmaken bij eerste gebruik; zonder salt is een hash terug te rekenen
if [ ! -f "$SALT_FILE" ]; then
    head -c32 /dev/urandom | base64 > "$SALT_FILE"
    chmod 600 "$SALT_FILE"
fi

# Domeinenlijst opbouwen uit DirectAdmin
DOMAINS=$(mktemp)
trap 'rm -f "$DOMAINS"' EXIT

if [ -f /etc/virtual/domains ]; then
    grep -v '^\s*$' /etc/virtual/domains > "$DOMAINS"
fi

# Op een Dovecot-proxy staan de domeinen van elke backend als mappen onder
# /etc/virtual-sync/<server>/domains/
for d in /etc/virtual-sync/*/domains; do
    [ -d "$d" ] && find "$d" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' >> "$DOMAINS"
done

if [ ! -s "$DOMAINS" ] && [ -d /etc/virtual ]; then
    # Fallback: mapnamen onder /etc/virtual zijn de domeinen
    find /etc/virtual -maxdepth 1 -mindepth 1 -type d -printf '%f\n' > "$DOMAINS"
fi

perl -e '
use strict;
use Digest::MD5 qw(md5_hex);

my $salt_file   = shift;
my $domain_file = shift;
my $keep_ip     = shift;

open(my $sf, "<", $salt_file) or die "salt: $!";
my $salt = <$sf>; chomp $salt; close $sf;

# Eigen proxyadressen (DirectAdmin) worden nooit gemaskeerd
my %keep;
if (open(my $kf, "<", "/etc/virtual/proxy_hosts_ip")) {
    while (<$kf>) { s/\s+//g; $keep{$_} = 1 if length; }
    close $kf;
}

my $ipv4 = qr/(?:\d{1,3}\.){3}\d{1,3}/;
my $ipv6 = qr/[0-9a-fA-F]{0,4}(?::[0-9a-fA-F]{0,4}){2,7}/;

sub mask_ip {
    my $ip = shift;
    return $ip if $keep_ip || $keep{$ip};
    return $ip if $ip =~ /^(?:127\.|10\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.)/;
    return $ip if $ip =~ /^(?:::1|fe80:|f[cd][0-9a-f]{2}:)/i || $ip !~ /\d/;
    my $h = substr(md5_hex($salt . lc $ip), 0, 6);
    if ($ip =~ /^(\d+\.\d+)\./) { return "$1.x.x-$h"; }
    if ($ip =~ /^([0-9a-fA-F]{1,4}:[0-9a-fA-F]{1,4}):/) { return "$1::x-$h"; }
    return "ip-$h";
}

# Eigen domeinen inlezen
my %own;
open(my $df, "<", $domain_file) or die "domains: $!";
while (<$df>) { chomp; s/^\s+|\s+$//g; $own{lc $_} = 1 if length; }
close $df;

# Is het domein (of een bovenliggend domein) van ons?
sub is_own {
    my $probe = lc shift;
    while ($probe =~ /\./) {
        return 1 if $own{$probe};
        $probe =~ s/^[^.]+\.//;
    }
    return 0;
}

# Hash zonder domein, zodat een los local part dezelfde naam krijgt als het
# bijbehorende adres: "=> user-abc <user-abc@klant.nl>"
sub hash_of {
    my ($local, $domain) = @_;
    return "user-" . substr(md5_hex($salt . lc($local) . lc($domain)), 0, 10);
}

sub anon {
    my ($local, $domain) = @_;
    return hash_of($local, $domain) . "\@$domain";
}

# VERP en SRS verstoppen een adres in het local part van een ander adres:
# bounces+123-jan=klant.nl@esp.example of SRS0=ab=cd=klant.nl=jan@forwarder.example
sub hides_own {
    my $local = shift;
    while ($local =~ /=([a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+)/g) {
        return 1 if is_own($1);
    }
    return 0;
}

# Een loginnaam zonder @ maskeren; met @ laten we over aan de adresregel verderop,
# die eigen en externe domeinen uit elkaar houdt. Leeg, "?" en al gemaskeerd: laten staan.
sub mask_login {
    my $name = shift;
    return $name if $name eq "" || $name eq "?" || $name =~ /\@/;
    return $name if $name =~ /^(?:user|verp|fwd)-[0-9a-f]{10}$/;
    return hash_of($name, "");
}

while (my $line = <STDIN>) {
    # Dovecot: user=<jan>, proxy(jan,1.2.3.4:143), passwd-file(jan,1.2.3.4,<id>),
    # imap(jan)<pid>, en "(username: Jan Jansen)" bij een geweigerde naam
    $line =~ s{(user=<)([^>]*)(>)}{$1 . mask_login($2) . $3}ge;
    # auth-worker(16763) zonder komma is een procesnummer, geen naam
    $line =~ s{\b((?:imap|pop3|lmtp|managesieve|submission|sieve|proxy|passwd-file|shadow|pam|plain|login|checkpassword|auth-worker)\()([^,()<>]*)(?=[,)])}{
        my ($p, $n) = ($1, $2);
        ($p eq "auth-worker(" && $n =~ /^\d+$/) ? "$p$n" : $p . mask_login($n);
    }ge;
    $line =~ s{(\(username: )([^)]*)(\))}{$1 . mask_login($2) . $3}ge;

    # Roundcube userlogins.log: "Successful login for jan (ID: 3) from 1.2.3.4"
    $line =~ s{(\blogin for )(\S+)}{$1 . mask_login($2)}ge;

    # IP-adressen van gebruikers. Dovecot: rip=1.2.3.4, en het IP in
    # passwd-file(jan,1.2.3.4,<id>) of plain(?,1.2.3.4,<id>). proxy(jan,ip:poort)
    # is de backend, lip= de eigen server: die blijven staan.
    $line =~ s{(\brip=)($ipv4|$ipv6)(?=[,\s]|$)}{$1 . mask_ip($2)}ge;
    $line =~ s{(\([^,()<>]*,)($ipv4|$ipv6)(?=,<|\))}{$1 . mask_ip($2)}ge;
    # Roundcube: "... login for jan (ID: 3) from 1.2.3.4"
    $line =~ s{(\blogin for \S+.*? from )($ipv4|$ipv6)}{$1 . mask_ip($2)}ge;
    # Exim: alleen bij een login. I=[...] is de eigen interface.
    if ($line =~ / A=\S+| authenticator failed/) {
        $line =~ s{(?<!I=)\[($ipv4|$ipv6)\]}{"[" . mask_ip($1) . "]"}ge;
    }

    # Exim: geauthenticeerd versturen als A=plain:jan, mislukt als (set_id=jan)
    $line =~ s{(\bA=[a-z_]+:)([^\s\@]+)(?=\s)}{$1 . mask_login($2)}ge;
    # Alleen als er geen @ volgt: set_id=jan@klant.nl laten we aan de adresregel,
    # zodat die dezelfde hash krijgt als in eerdere versies
    $line =~ s{(\bset_id=)([^)\s\@]+)(?=[)\s])}{$1 . mask_login($2)}ge;

    # Maildir-paden van subaccounts: /imap/klant.nl/jan/Maildir
    $line =~ s{(/imap/([a-zA-Z0-9.-]+)/)([^/\s]+)(?=/)}{
        is_own($2) ? $1 . hash_of($3, $2) : "$1$3"
    }ge;

    # Exim zet bij een aflevering het local part los voor het adres:
    # "=> jan <jan@klant.nl>". Bij een forward staat daar het doeladres:
    # "=> jan@gmail.com <jan@klant.nl>", ook dat is van de klant. Paden en
    # pipes laten we staan.
    $line =~ s{((?:=>|->|\*>|\*\*|==)\s+)([^\s<@/|][^\s<]*)(\s+<[^\s<>@]+\@([^\s<>]+)>)}{
        my ($pre, $tok, $post, $d) = ($1, $2, $3, $4);
          !is_own($d)                                ? "$pre$tok$post"
        : $tok !~ /\@/                               ? $pre . hash_of($tok, $d) . $post
        : $tok =~ /^([^@]+)\@([^@]+)$/ && !is_own($2) ? $pre . "fwd-" . substr(md5_hex($salt . lc $tok), 0, 10) . "\@$2" . $post
        :                                              "$pre$tok$post";
    }ge;

    # Adres maskeren als het domein van ons is, of als het local part via
    # VERP of SRS een adres op ons domein bevat
    $line =~ s{
        ([a-zA-Z0-9._%+=-]+) @ ([a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+)
    }{
        my ($l, $d) = ($1, $2);
          is_own($d)    ? anon($l, $d)
        : hides_own($l) ? "verp-" . substr(md5_hex($salt . lc $l), 0, 10) . "\@$d"
        :                 "$l\@$d";
    }gex;

    print $line;
}
' "$SALT_FILE" "$DOMAINS" "$KEEP_IP"
