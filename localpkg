#!/usr/bin/env bash
#
# localpkg — swap a vendored nickdekruijk package for the local checkout beside the
# project, so you develop against your working copy without touching composer.json or
# the lock. The link is a local act: composer install/update replaces it with the
# release again, which is the point — nothing about it can reach a server.
#
#   localpkg                 list vendor/nickdekruijk/* and which are linked
#   localpkg leap            link vendor/nickdekruijk/leap to ../nickdekruijk/leap
#   localpkg leap template   link several at once
#   localpkg -u leap         undo: reinstall that package from composer
#
# The checkout is expected as a sibling of the project: ../nickdekruijk/<pkg>. Run from
# the project root (where composer.json lives).

set -euo pipefail

vendor_dir="vendor/nickdekruijk"

die() { printf 'localpkg: %s\n' "$1" >&2; exit 1; }

[ -f composer.json ] || die "no composer.json here — run from the project root"
[ -d "$vendor_dir" ] || die "no $vendor_dir — is this a leap project, and has composer installed?"

# Where the checkouts live: a nickdekruijk/ folder next to the project.
checkout_root="$(cd .. && pwd)/nickdekruijk"

list() {
    printf '%-24s %s\n' "PACKAGE" "SOURCE"
    for path in "$vendor_dir"/*; do
        [ -e "$path" ] || continue
        name="$(basename "$path")"
        if [ -L "$path" ]; then
            printf '%-24s -> %s\n' "$name" "$(readlink "$path")"
        else
            printf '%-24s composer\n' "$name"
        fi
    done
}

link_one() {
    local pkg="$1"
    local checkout="$checkout_root/$pkg"
    local target="$vendor_dir/$pkg"

    # Never rm before the destination is known good, or you strand the project on a
    # broken symlink — the failure mode this script exists to avoid.
    [ -d "$checkout" ] || die "no checkout at $checkout — clone it there first"

    if [ -L "$target" ] && [ "$(readlink "$target")" = "../../../nickdekruijk/$pkg" ]; then
        printf 'localpkg: %s already linked\n' "$pkg"
        return
    fi

    rm -rf "$target"
    # Relative, from vendor/nickdekruijk/, so it survives the project being moved.
    ln -s "../../../nickdekruijk/$pkg" "$target"
    printf 'localpkg: %s -> checkout\n' "$pkg"
}

unlink_one() {
    local pkg="$1"
    local target="$vendor_dir/$pkg"

    [ -L "$target" ] || { printf 'localpkg: %s is not linked\n' "$pkg"; return; }

    # Drop the link, then let install restore the package from the lock. Not `composer
    # reinstall`: that needs the package present to reinstall it, and the link is already
    # gone. install sees it missing and puts back exactly what the lock records — the
    # release, not master.
    rm -f "$target"
    printf 'localpkg: %s unlinked, restoring from composer…\n' "$pkg"
    composer install --no-interaction
}

case "${1:-}" in
    "")        list ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    -u|--unlink)
        shift
        [ $# -gt 0 ] || die "which package to unlink?"
        for pkg in "$@"; do unlink_one "$pkg"; done ;;
    -*)        die "unknown option $1" ;;
    *)         for pkg in "$@"; do link_one "$pkg"; done ;;
esac
